# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Allowed Telegram user IDs (comma-separated). Empty = allow all.
ALLOWED_USERS=

# LLM Backend: "ollama" or "lmstudio"
LLM_BACKEND=ollama

# Ollama settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# LM Studio settings (if using lmstudio backend)
LMSTUDIO_HOST=http://localhost:1234
LMSTUDIO_MODEL=local-model

# Tool execution timeout (seconds)
TOOL_TIMEOUT=30

# Require confirmation for tool execution (true/false)
TOOL_CONFIRMATION=false

# Max conversation history length (number of messages)
MAX_HISTORY=50

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
